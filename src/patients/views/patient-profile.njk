{% extends "layout/base.njk" %}

{% block content %}
  <div class="space-y-6">

    {# Identidad: es el encabezado de la página, no una card que repite el título #}
    <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex min-w-0 items-center gap-4">
          <div class="avatar placeholder">
            <div class="w-12 rounded-full bg-primary text-primary-content">
              <span class="text-lg">{{ patient.firstNames[0] }}{{ patient.lastNames[0] }}</span>
            </div>
          </div>
          <div class="min-w-0">
            <h1 class="text-lg font-semibold tracking-tight">{{ patient.fullName }}</h1>
            <p class="text-sm text-base-content/70">Paciente #{{ patient.id }}</p>
          </div>
        </div>
        <a href="/patients/{{ patient.id }}/edit" class="btn btn-sm btn-primary">
          <i data-lucide="pencil" class="h-4 w-4"></i>
          Editar perfil
        </a>
      </div>
    </section>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

      {# Columna de datos #}
      <div class="space-y-6 lg:col-span-1">

        <section class="rounded-box border border-base-300 bg-base-100 p-4">
          <h2 class="text-xs font-medium text-base-content/70">Datos personales</h2>
          <dl class="mt-3 space-y-2 text-sm">
            <div>
              <dt class="text-base-content/70">Email</dt>
              <dd class="font-medium break-all">{{ patient.email }}</dd>
            </div>
            <div>
              <dt class="text-base-content/70">DNI</dt>
              <dd class="font-medium tabular-nums">{{ patient.nationalId }}</dd>
            </div>
            <div>
              <dt class="text-base-content/70">Teléfono</dt>
              <dd class="font-medium tabular-nums">{{ patient.phone }}</dd>
            </div>
            <div>
              <dt class="text-base-content/70">Dirección</dt>
              <dd class="font-medium">{{ patient.address }}</dd>
            </div>
          </dl>
        </section>

        <section class="rounded-box border border-base-300 bg-base-100 p-4">
          <h2 class="text-xs font-medium text-base-content/70">Obra social</h2>
          {% if patient.healthInsurances.length > 0 %}
            {% set insurance = patient.healthInsurances[0] %}
            <div class="mt-3 flex items-baseline justify-between gap-3">
              <p class="text-sm font-medium">{{ insurance.insuranceName }}</p>
              <p class="font-mono text-[13px] tabular-nums text-base-content/70">{{ insurance.memberNumber }}</p>
            </div>
          {% else %}
            <p class="mt-3 text-sm text-base-content/70">Sin obra social vinculada.</p>
          {% endif %}
        </section>

        <section class="rounded-box border border-base-300 bg-base-100 p-4">
          <h2 class="text-xs font-medium text-base-content/70">Documento de identidad</h2>
          {% if patient.nationalIdImageUrl %}
            <div class="mt-3 overflow-hidden rounded-field border border-base-300">
              <img
                src="{{ patient.nationalIdImageUrl }}"
                alt="DNI de {{ patient.fullName }}"
                class="aspect-[3/2] w-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="hidden aspect-[3/2] w-full items-center justify-center bg-base-200 text-center text-sm text-base-content/60">
                El archivo no está disponible.
              </div>
            </div>
          {% else %}
            <p class="mt-3 text-sm text-base-content/70">Sin documento adjunto.</p>
          {% endif %}
        </section>

      </div>

      {# Columna de turnos #}
      <div class="lg:col-span-2">
        <section class="overflow-hidden rounded-box border border-base-300 bg-base-100">
          <div class="border-b border-base-300 p-4">
            <h2 class="text-sm font-semibold">Turnos médicos</h2>
          </div>

          <div class="tabs tabs-border px-4 pt-2">
            {# Macro for rendering slot list #}
            {% macro renderSlotList(slots, emptyMessage) %}
              {% if slots.length > 0 %}
                <div class="overflow-x-auto">
                  <table class="table table-sm">
                    <thead>
                      <tr class="border-base-300">
                        <th class="text-xs font-medium text-base-content/70">Fecha</th>
                        <th class="text-xs font-medium text-base-content/70">Hora</th>
                        <th class="text-xs font-medium text-base-content/70">Profesional</th>
                        <th class="hidden text-xs font-medium text-base-content/70 sm:table-cell">Especialidad</th>
                        <th class="text-xs font-medium text-base-content/70">Estado</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for slot in slots %}
                        <tr class="border-base-300">
                          <td>
                            <div class="flex flex-col">
                              <span class="text-sm font-medium tabular-nums">{{ slot.startsAt | date("DD/MM/YYYY") }}</span>
                              <span class="text-xs text-base-content/60">{{ slot.location }}</span>
                            </div>
                          </td>
                          <td class="font-mono text-[13px] tabular-nums">{{ slot.startsAt | time }}</td>
                          <td class="text-sm font-medium">{{ slot.professionalName }}</td>
                          <td class="hidden text-sm text-base-content/80 sm:table-cell">{{ slot.specialty }}</td>
                          <td>
                            {% import "macros/slot-status-badge.njk" as StatusBadge %}
                            {{ StatusBadge.renderStatusBadge(slot.status) }}
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% else %}
                <div class="px-6 py-12 text-center">
                  <p class="text-sm text-base-content/70">{{ emptyMessage }}</p>
                </div>
              {% endif %}
            {% endmacro %}

            {# Tab 1: Hoy #}
            <input type="radio" name="turnos_tabs" role="tab" class="tab" aria-label="Hoy" checked="checked" />
            <div role="tabpanel" class="tab-content p-0 pt-2">
              {{ renderSlotList(slotsToday, "No tenés turnos programados para hoy.") }}
            </div>

            {# Tab 2: Futuros #}
            <input type="radio" name="turnos_tabs" role="tab" class="tab" aria-label="Futuros" />
            <div role="tabpanel" class="tab-content p-0 pt-2">
              {{ renderSlotList(slotsFuture, "No tenés turnos futuros pendientes.") }}
            </div>

            {# Tab 3: Pasados #}
            <input type="radio" name="turnos_tabs" role="tab" class="tab" aria-label="Pasados" />
            <div role="tabpanel" class="tab-content p-0 pt-2">
              {{ renderSlotList(slotsPast, "No hay historial de turnos pasados.") }}
            </div>
          </div>
        </section>
      </div>

    </div>

  </div>
{% endblock %}
