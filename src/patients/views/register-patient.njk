{% extends "layout/base.njk" %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Registro de paciente", "Registra tu cuenta.") }}
{% endblock %}

{% block scripts %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('nationalIdImage');
    const previewContainer = document.getElementById('imagePreviewContainer');
    const previewImage = document.getElementById('imagePreview');
    const maxFileSize = 5 * 1024 * 1024; // 5MB in bytes

    if (fileInput) {
      fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];

        if (file) {
          // Validate file size
          if (file.size > maxFileSize) {
            alert('El archivo es demasiado grande. El tamaño máximo permitido es 5MB.');
            fileInput.value = '';
            previewContainer.classList.add('hidden');
            return;
          }

          // Validate file type
          const validTypes = ['image/png', 'image/jpeg', 'image/jpg'];
          if (!validTypes.includes(file.type)) {
            alert('Formato de archivo no válido. Solo se permiten archivos .png, .jpg o .jpeg.');
            fileInput.value = '';
            previewContainer.classList.add('hidden');
            return;
          }

          // Read and display the image
          const reader = new FileReader();

          reader.onload = function(e) {
            previewImage.src = e.target.result;
            previewContainer.classList.remove('hidden');
          };

          reader.onerror = function() {
            alert('Error al leer el archivo. Por favor, intente nuevamente.');
            previewContainer.classList.add('hidden');
          };

          reader.readAsDataURL(file);
        } else {
          previewContainer.classList.add('hidden');
        }
      });

      // Hide preview when form is reset
      const form = fileInput.closest('form');
      if (form) {
        form.addEventListener('reset', function() {
          previewContainer.classList.add('hidden');
          previewImage.src = '';
        });
      }
    }
  });
</script>
{% endblock scripts %}

{% block content %}
  {% import "partials/form-field.njk" as Field %}

  {% set insuranceOptions = [] %}
  {% for healthInsurance in healthInsurances %}
    {% set insuranceOptions = insuranceOptions.concat([{ value: healthInsurance.id, label: healthInsurance.name }]) %}
  {% endfor %}

  <form action="/patients"
        method="POST"
        class="max-w-3xl space-y-6"
        enctype="multipart/form-data">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos personales</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "firstNames",
          label: "Nombres",
          value: values.firstNames,
          error: errors.properties.firstNames[0] if errors.properties.firstNames else null,
          required: true,
          minlength: 2,
          maxlength: 100,
          pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
          title: "Solo letras, espacios, guiones o apóstrofes.",
          placeholder: "Nombre completo",
          hint: "Solo letras, espacios, guiones o apóstrofes. Entre 2 y 100 caracteres."
        }) }}

        {{ Field.text({
          name: "lastNames",
          label: "Apellido",
          value: values.lastNames,
          error: errors.properties.lastNames[0] if errors.properties.lastNames else null,
          required: true,
          minlength: 2,
          maxlength: 100,
          pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
          title: "Solo letras, espacios, guiones o apóstrofes.",
          placeholder: "Apellido",
          hint: "Solo letras, espacios, guiones o apóstrofes. Entre 2 y 100 caracteres."
        }) }}

        {{ Field.text({
          name: "nationalId",
          label: "Número de DNI",
          value: values.nationalId,
          error: errors.properties.nationalId[0] if errors.properties.nationalId else null,
          required: true,
          minlength: 7,
          maxlength: 9,
          pattern: "[0-9]{7,9}",
          title: "El DNI debe tener entre 7 y 9 números sin puntos ni letras.",
          placeholder: "Número de DNI",
          hint: "Entre 7 y 9 números, sin puntos ni letras."
        }) }}
      </div>

      {# El input de archivo conserva su marcado: tiene vista previa propia por JS #}
      <div class="mt-4">
        <label for="nationalIdImage" class="text-xs font-medium text-base-content/70">
          Imagen de DNI<span class="ml-0.5 text-error" aria-hidden="true">*</span>
        </label>
        <input
          type="file"
          name="nationalIdImage"
          id="nationalIdImage"
          class="file-input validator mt-1 w-full {{ 'input-error' if errors.properties.nationalIdImage }}"
          required
          accept=".png, .jpg, .jpeg"
          title="Debe ingresar una imagen de su DNI."
        />
        {% if errors.properties.nationalIdImage %}
          <p class="mt-1 text-xs text-error">{{ errors.properties.nationalIdImage.errors[0] }}</p>
        {% endif %}
        <div id="imagePreviewContainer" class="mt-3 hidden">
          <p class="text-xs font-medium text-base-content/70">Vista previa</p>
          <div class="mt-1 rounded-box border border-base-300 bg-base-100 p-4">
            <img id="imagePreview" src="" alt="Vista previa de DNI" class="mx-auto max-h-96 max-w-full rounded-box" />
          </div>
        </div>
        <div class="validator-hint">
          Máximo 5MB. Formatos aceptados: .png, .jpg, .jpeg.
        </div>
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de cuenta</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "email",
          type: "email",
          label: "Email",
          value: values.email,
          error: errors.properties.email[0] if errors.properties.email else null,
          required: true,
          placeholder: "correoelectronico@sitio.com",
          hint: "Ingrese un email válido."
        }) }}

        {{ Field.text({
          name: "password",
          type: "password",
          label: "Contraseña",
          error: errors.properties.password[0] if errors.properties.password else null,
          required: true,
          minlength: 8,
          maxlength: 100,
          placeholder: "Contraseña",
          hint: "Entre 8 y 100 caracteres."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de contacto</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "phone",
          type: "tel",
          label: "Teléfono",
          value: values.phone,
          error: errors.properties.phone[0] if errors.properties.phone else null,
          required: true,
          placeholder: "Número de teléfono",
          hint: "Ingrese un número de teléfono válido."
        }) }}

        {{ Field.text({
          name: "address",
          label: "Dirección",
          value: values.address,
          error: errors.properties.address[0] if errors.properties.address else null,
          required: true,
          minlength: 5,
          maxlength: 180,
          placeholder: "Dirección",
          hint: "Ingrese una dirección válida."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Obra social</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.select({
          name: "healthInsuranceId",
          label: "Obra social",
          value: values.healthInsuranceId,
          options: insuranceOptions,
          placeholder: "Seleccione una obra social",
          error: errors.properties.healthInsurances.items[0].properties.insuranceId.errors[0] if errors.properties.healthInsurances else null,
          required: true,
          hint: "Ingrese una obra social válida."
        }) }}

        {{ Field.text({
          name: "memberNumber",
          label: "Número de afiliado",
          value: values.memberNumber,
          error: errors.properties.healthInsurances.items[0].properties.memberNumber.errors[0] if errors.properties.healthInsurances else null,
          placeholder: "Número de afiliado"
        }) }}
      </div>
    </fieldset>

    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
      <button type="reset" class="btn btn-ghost">Limpiar formulario</button>
      <button type="submit" class="btn btn-primary">Registrar</button>
    </div>
  </form>
{% endblock %}
