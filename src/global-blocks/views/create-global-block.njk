{% extends "layout/base.njk" %}
{% import "partials/form-field.njk" as Field %}

{% block content %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Nuevo bloqueo global", "Definir un período de bloqueo para todas las agendas.") }}

  <form action="/global-blocks" method="POST" class="max-w-2xl space-y-6">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Período del bloqueo</legend>

      {{ Field.text({
        name: "startDate",
        type: "date",
        label: "Fecha de inicio",
        value: values.startDate,
        error: errors.properties.startDate[0] if errors.properties.startDate else null,
        required: true,
        hint: "Seleccione la fecha de inicio del bloqueo."
      }) }}

      {{ Field.text({
        name: "endDate",
        type: "date",
        label: "Fecha de fin",
        value: values.endDate,
        error: errors.properties.endDate[0] if errors.properties.endDate else null,
        required: true,
        hint: "Seleccione la fecha de fin del bloqueo (puede ser el mismo día)."
      }) }}

      {{ Field.text({
        name: "reason",
        label: "Motivo",
        value: values.reason,
        error: errors.properties.reason[0] if errors.properties.reason else null,
        required: true,
        minlength: 3,
        maxlength: 500,
        placeholder: "Ej: Feriado nacional, Jornada de mantenimiento",
        hint: "Mínimo 3 caracteres, máximo 500."
      }) }}
    </fieldset>

    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
      <button type="submit" class="btn btn-primary">
        <i data-lucide="save" class="h-4 w-4"></i>
        Crear bloqueo
      </button>
      <a href="/global-blocks" class="btn btn-ghost">Cancelar</a>
    </div>
  </form>
{% endblock %}
