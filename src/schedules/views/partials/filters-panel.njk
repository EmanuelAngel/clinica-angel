{# Panel de filtros para comparar agendas #}
<div class="rounded-box border border-base-300 bg-base-100 p-4">
  <form method="GET" action="/schedules/compare" class="space-y-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div>
        <label for="filter-location" class="text-xs font-medium text-base-content/70">Sucursal</label>
        <select id="filter-location" name="location_id" class="select select-sm mt-1 w-full">
          <option value="">Todas las sucursales</option>
          {% for location in locations %}
            <option value="{{ location.id }}" {{ 'selected' if filters.location_id == location.id }}>
              {{ location.name }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div>
        <label for="filter-specialty" class="text-xs font-medium text-base-content/70">Especialidad</label>
        <select id="filter-specialty" name="specialty_id" class="select select-sm mt-1 w-full">
          <option value="">Todas las especialidades</option>
          {% for specialty in specialties %}
            <option value="{{ specialty.id }}" {{ 'selected' if filters.specialty_id == specialty.id }}>
              {{ specialty.name }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div>
        <label for="filter-professional" class="text-xs font-medium text-base-content/70">Profesional</label>
        <select id="filter-professional" name="professional_id" class="select select-sm mt-1 w-full">
          <option value="">Todos los profesionales</option>
          {% for professional in professionals %}
            <option value="{{ professional.id }}" {{ 'selected' if filters.professional_id == professional.id }}>
              {{ professional.firstNames }} {{ professional.lastNames }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div>
        <label for="filter-classification" class="text-xs font-medium text-base-content/70">Clasificación</label>
        <select id="filter-classification" name="classification_id" class="select select-sm mt-1 w-full">
          <option value="">Todas las clasificaciones</option>
          {% for classification in classifications %}
            <option value="{{ classification.id }}" {{ 'selected' if filters.classification_id == classification.id }}>
              {{ classification.name }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div>
        <label for="filter-date" class="text-xs font-medium text-base-content/70">Fecha</label>
        <input
          type="date"
          id="filter-date"
          name="date"
          value="{{ date | date('yyyy-MM-dd') }}"
          class="input input-sm mt-1 w-full tabular-nums"
        />
      </div>
    </div>

    <div class="flex justify-end gap-2">
      <a href="/schedules/compare" class="btn btn-sm btn-ghost">
        <i data-lucide="x" class="h-4 w-4"></i>
        Limpiar
      </a>
      <button type="submit" class="btn btn-sm btn-primary">
        <i data-lucide="search" class="h-4 w-4"></i>
        Buscar
      </button>
    </div>
  </form>
</div>
