{#
  Grilla de turnos compartida por schedule-drilldown y compare-schedules.

  Las filas se derivan de los turnos reales (`rows`, calculadas en el
  controller), no de una escalera fija de 10 minutos: cualquier duración de
  turno se renderiza completa.

  Parámetros:
    columns: [{ label, sub, meta, url, paused, dayBlock, slots }]
    rows:    Date[] ascendente
    userRole
    emptyMessage
#}
{% import "macros/slot-cell.njk" as slotMacros %}

{% macro render(columns, rows, userRole, emptyMessage) %}
  {% if rows | length == 0 %}
    <div class="rounded-box border border-base-300 bg-base-100 px-6 py-12 text-center">
      <p class="text-sm text-base-content/70">{{ emptyMessage or "No hay turnos para mostrar." }}</p>
    </div>
  {% else %}
    <div class="overflow-hidden rounded-box border border-base-300 bg-base-100">
      <div class="time-grid-container max-h-[80vh] overflow-y-auto">
        <table class="table table-xs table-pin-rows">
          <thead>
            <tr class="border-b border-base-300">
              <th class="min-w-20 bg-base-100 pr-2 text-right text-xs font-medium text-base-content/70">Hora</th>
              {% for col in columns %}
                <th class="min-w-[180px] border-l border-base-300 bg-base-100 p-0 text-center align-top">
                  {% if col.url %}
                    <a href="{{ col.url }}" class="flex h-full flex-col gap-0.5 p-2 hover:bg-base-200">
                      <span class="flex items-center justify-center gap-1 text-sm font-semibold text-base-content">{{ col.label }}</span>
                      {% if col.sub %}<span class="text-xs text-base-content/70">{{ col.sub }}</span>{% endif %}
                      {% if col.meta %}<span class="text-xs text-base-content/60">{{ col.meta }}</span>{% endif %}
                      {% if col.paused %}<span class="badge badge-xs badge-warning">Pausada</span>{% endif %}
                    </a>
                  {% else %}
                    <div class="flex flex-col gap-0.5 p-2">
                      <span class="text-sm font-semibold text-base-content">{{ col.label }}</span>
                      {% if col.sub %}<span class="text-xs text-base-content/70">{{ col.sub }}</span>{% endif %}
                      {% if col.meta %}<span class="text-xs text-base-content/60">{{ col.meta }}</span>{% endif %}
                      {% if col.paused %}<span class="badge badge-xs badge-warning">Pausada</span>{% endif %}
                    </div>
                  {% endif %}
                </th>
              {% endfor %}
            </tr>
          </thead>

          <tbody>
            {% for row in rows %}
              {% set isFirstRow = loop.first %}
              {% set isOnTheHour = (row | date('m')) == '00' %}
              <tr class="hover:bg-base-200/60">
                <th class="w-20 bg-base-100 pr-2 text-right font-mono text-[11px] tabular-nums {{ 'font-semibold text-base-content' if isOnTheHour else 'text-base-content/40' }}">
                  {{ row | time }}
                </th>

                {% for col in columns %}
                  <td class="min-w-[180px] border-l border-base-300/70 p-0.5">
                    {% if col.dayBlock %}
                      {% if userRole == Roles.ADMIN or userRole == Roles.SECRETARY %}
                        {% if isFirstRow %}
                          <div class="rounded bg-error/15 p-0.5 text-center text-[11px] text-error" title="{{ col.dayBlock.reason }}">
                            <i data-lucide="ban" class="inline h-3 w-3"></i>
                            Bloqueado
                          </div>
                        {% else %}
                          <div class="h-4 rounded bg-error/10"></div>
                        {% endif %}
                      {% else %}
                        {% if isFirstRow %}
                          <div class="rounded bg-base-300/70 p-0.5 text-center text-[11px] text-base-content/60">
                            No disponible
                          </div>
                        {% else %}
                          <div class="h-4 rounded bg-base-300/40"></div>
                        {% endif %}
                      {% endif %}
                    {% else %}
                      {# Se renderiza todo turno que empiece en esta fila; sin relleno decorativo #}
                      {% for slot in col.slots %}
                        {% if (slot.startsAt | date('H')) == (row | date('H')) and (slot.startsAt | date('m')) == (row | date('m')) %}
                          {{ slotMacros.renderSlot(slot, userRole) }}
                        {% endif %}
                      {% endfor %}
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}
{% endmacro %}

<style>
  .time-grid-container {
    scrollbar-width: thin;
  }

  .time-grid-container::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .time-grid-container::-webkit-scrollbar-track {
    background: var(--fallback-b2, oklch(var(--b2) / 1));
  }

  .time-grid-container::-webkit-scrollbar-thumb {
    background: var(--fallback-bc, oklch(var(--bc) / 0.2));
    border-radius: 4px;
  }

  .time-grid-container::-webkit-scrollbar-thumb:hover {
    background: var(--fallback-bc, oklch(var(--bc) / 0.4));
  }
</style>
