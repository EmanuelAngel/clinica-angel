{% extends "layout/base.njk" %}

{% set title = "Comparar Agendas" %}

{% block pageInfo %}
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold">Comparar Agendas</h1>
    <p class="text-base-content/70">Vista de grilla de agendas médicas</p>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="space-y-6">
  {# Filters Panel #}
  {% include "partials/filters-panel.njk" %}

  {# Date Display and Navigation #}
  <div class="flex items-center justify-between bg-base-200 rounded-lg px-4 py-3">
    <a href="?{{ 'location_id=' + filters.location_id if filters.location_id }}{{ '&specialty_id=' + filters.specialty_id if filters.specialty_id }}{{ '&professional_id=' + filters.professional_id if filters.professional_id }}{{ '&classification_id=' + filters.classification_id if filters.classification_id }}&date={{ (date | dateAdd(-1, 'days')) | date('yyyy-MM-dd') }}"
       class="btn btn-sm btn-ghost">
      <i data-lucide="chevron-left" class="w-4 h-4"></i>
      Anterior
    </a>
    
    <div class="text-center">
      <span class="text-lg font-semibold">{{ date | date('EEEE, d MMMM yyyy', 'es') }}</span>
    </div>
    
    <div class="flex gap-2">
      <a href="?{{ 'location_id=' + filters.location_id if filters.location_id }}{{ '&specialty_id=' + filters.specialty_id if filters.specialty_id }}{{ '&professional_id=' + filters.professional_id if filters.professional_id }}{{ '&classification_id=' + filters.classification_id if filters.classification_id }}"
         class="btn btn-sm btn-outline btn-primary">
        Hoy
      </a>
      <a href="?{{ 'location_id=' + filters.location_id if filters.location_id }}{{ '&specialty_id=' + filters.specialty_id if filters.specialty_id }}{{ '&professional_id=' + filters.professional_id if filters.professional_id }}{{ '&classification_id=' + filters.classification_id if filters.classification_id }}&date={{ (date | dateAdd(1, 'days')) | date('yyyy-MM-dd') }}"
         class="btn btn-sm btn-ghost">
        Siguiente
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
      </a>
    </div>
  </div>

  {# Content Area #}
  {% if not hasFilters %}
    {# Empty State #}
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body items-center text-center py-16">
        <i data-lucide="calendar-search" class="w-16 h-16 text-base-content/30 mb-4"></i>
        <h2 class="card-title text-xl">Seleccione criterios para comparar agendas</h2>
        <p class="text-base-content/70 max-w-md">
          Utilice los filtros de arriba para seleccionar agendas por sucursal, especialidad, profesional o clasificación.
        </p>
      </div>
    </div>
  {% elif schedules.length == 0 %}
    {# No Results #}
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body items-center text-center py-16">
        <i data-lucide="calendar-x" class="w-16 h-16 text-base-content/30 mb-4"></i>
        <h2 class="card-title text-xl">No se encontraron agendas</h2>
        <p class="text-base-content/70 max-w-md">
          No hay agendas que coincidan con los filtros seleccionados.
        </p>
      </div>
    </div>
  {% else %}
    {# Time Grid #}
    {% include "partials/time-grid.njk" %}
  {% endif %}
</div>

{# Slot Details Modal #}
<dialog id="slot_details_modal" class="modal">
  <div class="modal-box max-w-2xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    
    <div id="modal_content" class="space-y-6">
      {# Header #}
      <div class="flex items-center justify-between">
        <h3 class="text-2xl font-bold" id="slot_datetime">17/04/2024 - 08:00</h3>
        <span id="slot_status_badge" class="badge badge-lg">Reservado</span>
      </div>

      {# Agenda Info #}
      <div>
        <h4 class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-3">Agenda</h4>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <p class="text-xs text-base-content/60">Clasificación</p>
            <p class="font-medium" id="slot_classification">Normal</p>
          </div>
          <div>
            <p class="text-xs text-base-content/60">Profesional</p>
            <p class="font-medium" id="slot_professional">Silvina Carrizo</p>
          </div>
          <div>
            <p class="text-xs text-base-content/60">Especialidad</p>
            <p class="font-medium" id="slot_specialty">Nutrición</p>
          </div>
          <div>
            <p class="text-xs text-base-content/60">Sucursal</p>
            <p class="font-medium" id="slot_location">Benavides</p>
          </div>
        </div>
      </div>

      {# Patient Info #}
      <div id="patient_section" class="hidden">
        <h4 class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-3">Paciente</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div>
            <p class="text-xs text-base-content/60">Nombres y apellidos</p>
            <p class="font-medium text-lg" id="patient_names">-</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <p class="text-xs text-base-content/60">DNI</p>
            <p class="font-medium" id="patient_dni">-</p>
          </div>
          <div>
            <p class="text-xs text-base-content/60">Correo electrónico</p>
            <p class="font-medium" id="patient_email">-</p>
          </div>
          <div>
            <p class="text-xs text-base-content/60">Teléfono</p>
            <p class="font-medium" id="patient_phone">-</p>
          </div>
          <div>
            <p class="text-xs text-base-content/60">Dirección</p>
            <p class="font-medium" id="patient_address">-</p>
          </div>
        </div>
        
        <div class="mb-4">
          <p class="text-xs text-base-content/60 mb-2">Obras sociales</p>
          <div id="patient_insurances" class="flex flex-wrap gap-2">
            {# Insurances will be injected here #}
          </div>
        </div>

        <div id="dni_image_section" class="hidden">
          <p class="text-xs text-base-content/60 mb-2">Imagen del DNI</p>
          <div class="bg-base-200 rounded-lg aspect-video flex items-center justify-center overflow-hidden border border-base-300">
            <img id="patient_dni_image" src="" alt="DNI Paciente" class="max-w-full max-h-full object-contain" />
            <div id="no_dni_image" class="text-base-content/30 flex flex-col items-center">
              <i data-lucide="image-off" class="w-12 h-12 mb-2"></i>
              <span>Imagen no cargada</span>
            </div>
          </div>
        </div>
      </div>

      {# Reservation Form (shown only for FREE slots) #}
      <div id="reservation_section" class="hidden">
        <h4 class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-3">Reservar Turno</h4>
        <form id="reservation_form" class="space-y-4">
          {% if userRole == Roles.ADMIN or userRole == Roles.SECRETARY %}
          <div class="form-control w-full">
            <label class="label">
              <span class="label-text font-semibold">Paciente</span>
            </label>
            <select name="patientId" class="select select-bordered w-full select-sm" required>
              <option value="" disabled selected>Seleccione un paciente</option>
              {% for patient in patients %}
              <option value="{{ patient.id }}">{{ patient.firstNames }} {{ patient.lastNames }} (DNI: {{ patient.nationalId }})</option>
              {% endfor %}
            </select>
          </div>
          {% endif %}
          
          <div class="form-control w-full">
            <label class="label">
              <span class="label-text font-semibold">Motivo de consulta</span>
            </label>
            <textarea name="consultationReason" class="textarea textarea-bordered h-20 textarea-sm" placeholder="Ej: Control anual, Dolor de garganta..." required minlength="5"></textarea>
          </div>

          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary btn-sm" id="btn_reserve_submit">
              Confirmar Reserva
            </button>
          </div>
        </form>
      </div>

      {# State Actions #}
      <div id="actions_section">
        <h4 class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-3">Cambiar estado del horario a</h4>
        <div id="action_buttons" class="flex flex-wrap gap-2">
          <button id="btn_release" data-action="release" class="btn btn-xs btn-outline btn-success hidden">Libre</button>
          <button id="btn_cancel" data-action="cancel" class="btn btn-xs btn-outline btn-error hidden">Cancelado</button>
          <button id="btn_confirm" data-action="confirm" class="btn btn-xs btn-outline btn-primary hidden">Confirmado</button>
          <button id="btn_arrive" data-action="arrive" class="btn btn-xs btn-outline btn-accent hidden">Presente</button>
          <button id="btn_no_show" data-action="no-show" class="btn btn-xs btn-outline btn-secondary hidden">Ausente</button>
          <button id="btn_start" data-action="start" class="btn btn-xs btn-outline btn-info hidden">En consulta</button>
          <button id="btn_fulfill" data-action="fulfill" class="btn btn-xs btn-outline hidden">Atendido</button>
        </div>
        <p id="terminal_state_msg" class="text-[10px] text-base-content/40 mt-2 italic hidden">Este turno está en estado terminal y no puede ser modificado.</p>
      </div>

      {# Overbook Section - ADMIN/SECRETARY only, visible when slot is BOOKED #}
      {% if userRole == Roles.ADMIN or userRole == Roles.SECRETARY %}
      <div id="overbook_section" class="hidden">
        <div class="divider"></div>
        <h4 class="text-sm font-semibold text-base-content/50 uppercase tracking-wider mb-3">
          <i data-lucide="layers" class="w-4 h-4 inline mr-1"></i>
          Crear Sobreturno
        </h4>
        <form id="overbook_form" class="space-y-4">
          <div class="form-control w-full">
            <label class="label">
              <span class="label-text font-semibold">Paciente</span>
            </label>
            <select name="patientId" class="select select-bordered w-full select-sm" required>
              <option value="" disabled selected>Seleccione un paciente</option>
              {% for patient in patients %}
              <option value="{{ patient.id }}">{{ patient.firstNames }} {{ patient.lastNames }} (DNI: {{ patient.nationalId }})</option>
              {% endfor %}
            </select>
          </div>

          <div class="form-control w-full">
            <label class="label">
              <span class="label-text font-semibold">Motivo de consulta</span>
            </label>
            <textarea name="consultationReason" class="textarea textarea-bordered h-20 textarea-sm" placeholder="Ej: Control urgente, Derivación..." required minlength="5"></textarea>
          </div>

          <div class="flex justify-end">
            <button type="submit" class="btn btn-warning btn-sm" id="btn_overbook_submit">
              <i data-lucide="layers" class="w-4 h-4"></i>
              Crear Sobreturno
            </button>
          </div>
        </form>
      </div>
      {% endif %}

      <div class="modal-action">
        <form method="dialog">
          <button class="btn">Cerrar</button>
        </form>
      </div>
    </div>
  </div>
</dialog>
{% endblock %}

{% block scripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Re-initialize lucide icons
    lucide.createIcons();

    const modal = document.getElementById('slot_details_modal');
    const triggers = document.querySelectorAll('.slot-trigger');

    // Status badge styles
    const statusBadges = {
      'FREE': 'badge-success',
      'BOOKED': 'badge-warning',
      'CANCELLED': 'badge-error',
      'PROPOSED': 'badge-primary',
      'IN_PROGRESS': 'badge-info',
      'FULFILLED': 'badge-neutral',
      'ARRIVED': 'badge-accent',
      'NO_SHOW': 'badge-error'
    };

    // Status labels in Spanish
    const statusLabels = {
      'FREE': 'Libre',
      'BOOKED': 'Reservado',
      'CANCELLED': 'Cancelado',
      'PROPOSED': 'Propuesto',
      'IN_PROGRESS': 'En curso',
      'FULFILLED': 'Cumplido',
      'ARRIVED': 'Llegó',
      'NO_SHOW': 'No asistió'
    };

    // State machine: valid transitions from each status
    const TRANSITIONS = {
      'FREE': [], // Reserve requires patient selection, handled separately
      'PROPOSED': ['confirm', 'cancel', 'release'],
      'BOOKED': ['arrive', 'no-show', 'release'],
      'CANCELLED': ['release'],
      'ARRIVED': ['start', 'release'],
      'NO_SHOW': ['release'],
      'IN_PROGRESS': ['fulfill', 'release'],
      'FULFILLED': [] // Terminal state
    };

    // API endpoints for each action
    const ACTION_ENDPOINTS = {
      'release': { path: '/api/v1/slots/{id}/release', method: 'POST' },
      'cancel': { path: '/api/v1/slots/{id}/cancel', method: 'PATCH' },
      'confirm': { path: '/api/v1/slots/{id}/confirm', method: 'PATCH' },
      'arrive': { path: '/api/v1/slots/{id}/arrive', method: 'PATCH' },
      'no-show': { path: '/api/v1/slots/{id}/no-show', method: 'PATCH' },
      'start': { path: '/api/v1/slots/{id}/start', method: 'PATCH' },
      'fulfill': { path: '/api/v1/slots/{id}/fulfill', method: 'PATCH' }
    };

    // Current slot data
    let currentSlot = null;

    /**
     * Show a toast notification
     */
    function showToast(message, type = 'info') {
      const alertClasses = {
        'success': 'alert-success',
        'error': 'alert-error',
        'info': 'alert-info',
        'warning': 'alert-warning'
      };
      
      const toast = document.createElement('div');
      toast.className = 'toast toast-top toast-end z-[9999]';
      toast.innerHTML = `
        <div class="alert ${alertClasses[type] || 'alert-info'}">
          <span>${message}</span>
        </div>
      `;
      document.body.appendChild(toast);
      
      setTimeout(() => toast.remove(), 4000);
    }

    /**
     * Update patient info section
     */
    function updatePatientInfo(patient) {
      const patientSection = document.getElementById('patient_section');
      if (patient) {
        patientSection.classList.remove('hidden');
        document.getElementById('patient_names').textContent = patient.fullNames;
        document.getElementById('patient_dni').textContent = patient.nationalId;
        document.getElementById('patient_email').textContent = patient.email;
        document.getElementById('patient_phone').textContent = patient.phone;
        document.getElementById('patient_address').textContent = patient.address;

        // Insurances
        const insuranceContainer = document.getElementById('patient_insurances');
        insuranceContainer.innerHTML = '';
        if (patient.insurances && patient.insurances.length > 0) {
          patient.insurances.forEach(ins => {
            const badge = document.createElement('span');
            badge.className = 'badge badge-outline';
            badge.textContent = `${ins.name} - ${ins.memberNumber}`;
            insuranceContainer.appendChild(badge);
          });
        } else {
          insuranceContainer.innerHTML = '<span class="text-sm text-base-content/40 italic">Ninguna</span>';
        }

        // DNI Image
        const dniImageSection = document.getElementById('dni_image_section');
        const dniImage = document.getElementById('patient_dni_image');
        const noDniImage = document.getElementById('no_dni_image');
        
        if (patient.nationalIdImageUrl) {
          dniImageSection.classList.remove('hidden');
          dniImage.src = patient.nationalIdImageUrl;
          dniImage.classList.remove('hidden');
          noDniImage.classList.add('hidden');
        } else {
          dniImageSection.classList.remove('hidden');
          dniImage.classList.add('hidden');
          noDniImage.classList.remove('hidden');
        }
      } else {
        patientSection.classList.add('hidden');
      }
    }

    /**
     * Render action buttons / reservation form based on status
     */
    function renderActionUI(status) {
      const allButtons = document.querySelectorAll('#action_buttons button');
      const terminalMsg = document.getElementById('terminal_state_msg');
      const reservationSection = document.getElementById('reservation_section');
      const actionsSection = document.getElementById('actions_section');
      const overbookSection = document.getElementById('overbook_section');
      const validActions = TRANSITIONS[status] || [];

      // Reset visibility
      allButtons.forEach(btn => btn.classList.add('hidden'));
      terminalMsg.classList.add('hidden');
      reservationSection.classList.add('hidden');
      actionsSection.classList.remove('hidden');
      if (overbookSection) overbookSection.classList.add('hidden');

      if (status === 'FULFILLED') {
        terminalMsg.classList.remove('hidden');
        return;
      }

      if (status === 'FREE') {
        reservationSection.classList.remove('hidden');
        actionsSection.classList.add('hidden');
        return;
      }

      // Show overbook section for PROPOSED slots
      if (status === 'PROPOSED' && overbookSection) {
        overbookSection.classList.remove('hidden');
        lucide.createIcons();
      }

      // Show valid action buttons
      validActions.forEach(action => {
        const btn = document.querySelector(`#action_buttons button[data-action="${action}"]`);
        if (btn) {
          btn.classList.remove('hidden');
        }
      });
    }

    /**
     * Handle reservation form submission
     */
    async function handleReserveSubmit(e) {
      e.preventDefault();
      if (!currentSlot) return;

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());
      
      const btn = document.getElementById('btn_reserve_submit');
      const originalText = btn.textContent;
      
      btn.disabled = true;
      btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';

      try {
        const response = await fetch(`/api/v1/slots/${currentSlot.id}/reserve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Error al reservar el turno');
        }

        // Success - refresh slot data
        const refreshResponse = await fetch(`/schedules/slots/${currentSlot.id}`);
        if (refreshResponse.ok) {
          currentSlot = await refreshResponse.json();
          
          // Update status badge
          const statusBadge = document.getElementById('slot_status_badge');
          statusBadge.textContent = statusLabels[currentSlot.status] || currentSlot.status;
          statusBadge.className = `badge badge-lg ${statusBadges[currentSlot.status] || ''}`;

          updatePatientInfo(currentSlot.patient);
          renderActionUI(currentSlot.status);
        }

        showToast(result.message || 'Turno reservado correctamente', 'success');

        // Update grid
        const gridCell = document.querySelector(`.slot-trigger[data-slot-id="${currentSlot.id}"]`);
        if (gridCell) {
          gridCell.className = gridCell.className
            .replace(/slot-(free|proposed|booked|cancelled|arrived|no-show|in-progress|fulfilled)/gi, '')
            .trim();
          gridCell.classList.add(`slot-${currentSlot.status.toLowerCase().replace('_', '-')}`);
        }

        // Reset form
        e.target.reset();

      } catch (error) {
        showToast(error.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }

    /**
     * Handle action button click
     */
    async function handleActionClick(action) {
      if (!currentSlot) return;

      const endpoint = ACTION_ENDPOINTS[action];
      if (!endpoint) return;

      const url = endpoint.path.replace('{id}', currentSlot.id);
      const btn = document.querySelector(`#action_buttons button[data-action="${action}"]`);
      
      // Show loading state
      const originalText = btn.textContent;
      btn.disabled = true;
      btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';

      try {
        const response = await fetch(url, {
          method: endpoint.method,
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Error al actualizar el turno');
        }

        // Success - refresh slot data
        const refreshResponse = await fetch(`/schedules/slots/${currentSlot.id}`);
        if (refreshResponse.ok) {
          currentSlot = await refreshResponse.json();
          
          // Update status badge
          const statusBadge = document.getElementById('slot_status_badge');
          statusBadge.textContent = statusLabels[currentSlot.status] || currentSlot.status;
          statusBadge.className = `badge badge-lg ${statusBadges[currentSlot.status] || ''}`;

          updatePatientInfo(currentSlot.patient);
          renderActionUI(currentSlot.status);
        }

        showToast(data.message || 'Turno actualizado correctamente', 'success');

        // Update grid
        const gridCell = document.querySelector(`.slot-trigger[data-slot-id="${currentSlot.id}"]`);
        if (gridCell) {
          gridCell.className = gridCell.className
            .replace(/slot-(free|proposed|booked|cancelled|arrived|no-show|in-progress|fulfilled)/gi, '')
            .trim();
          gridCell.classList.add(`slot-${currentSlot.status.toLowerCase().replace('_', '-')}`);
        }

      } catch (error) {
        showToast(error.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }

    // Attach form submit handler
    const reservationForm = document.getElementById('reservation_form');
    if (reservationForm) {
      reservationForm.addEventListener('submit', handleReserveSubmit);
    }

    // Attach overbook form submit handler
    const overbookForm = document.getElementById('overbook_form');
    if (overbookForm) {
      overbookForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentSlot) return;

        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        const btn = document.getElementById('btn_overbook_submit');
        const originalHTML = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';

        try {
          const response = await fetch(`/api/v1/slots/${currentSlot.id}/overbook`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'Error al crear el sobreturno');
          }

          showToast(result.message || 'Sobreturno creado correctamente', 'success');
          e.target.reset();

          // Reload page to reflect the new overbook in the grid
          setTimeout(() => window.location.reload(), 1000);

        } catch (error) {
          showToast(error.message, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      });
    }

    // Attach click handlers to action buttons
    document.querySelectorAll('#action_buttons button').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = btn.dataset.action;
        if (action) handleActionClick(action);
      });
    });

    // Slot trigger click handlers
    triggers.forEach(trigger => {
      trigger.addEventListener('click', async () => {
        const slotId = trigger.dataset.slotId;
        if (!slotId) return;

        try {
          // Show loading state or clear previous data
          modal.showModal();
          
          const response = await fetch(`/schedules/slots/${slotId}`);
          if (!response.ok) throw new Error('Error al obtener datos');
          
          currentSlot = await response.json();
          
          // Populate Modal
          // Use .replace('Z', '') to treat the ISO string as local time
          const date = new Date(currentSlot.startsAt.replace('Z', ''));
          const dateStr = date.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
          const timeStr = date.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
          
          document.getElementById('slot_datetime').textContent = `${dateStr} - ${timeStr}`;
          
          const statusBadge = document.getElementById('slot_status_badge');
          statusBadge.textContent = statusLabels[currentSlot.status] || currentSlot.status;
          statusBadge.className = `badge badge-lg ${statusBadges[currentSlot.status] || ''}`;

          document.getElementById('slot_classification').textContent = currentSlot.schedule.classification;
          document.getElementById('slot_professional').textContent = currentSlot.schedule.professional;
          document.getElementById('slot_specialty').textContent = currentSlot.schedule.specialty;
          document.getElementById('slot_location').textContent = currentSlot.schedule.location;

          updatePatientInfo(currentSlot.patient);
          renderActionUI(currentSlot.status);

        } catch (error) {
          console.error(error);
          showToast('Error al cargar los detalles del turno', 'error');
          modal.close();
        }
      });
    });
  });
</script>
{% endblock %}
