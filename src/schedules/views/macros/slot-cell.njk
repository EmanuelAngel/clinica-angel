{#
  Slot Cell Macro - Renders a single slot with status badge and patient info
  
  Parameters:
    - slot: SlotForDay object with id, startsAt, status, patientName, isOverbook
    - userRole: User's role (ADMIN, SECRETARY, PROFESSIONAL, PATIENT)
#}

{% macro renderSlot(slot, userRole) %}
  {% set statusBadge = {
    'FREE': 'badge-ghost text-base-content/70',
    'BOOKED': 'badge-neutral',
    'CANCELLED': 'badge-error',
    'PROPOSED': 'badge-primary',
    'IN_PROGRESS': 'badge-info',
    'FULFILLED': 'badge-ghost',
    'ARRIVED': 'badge-accent',
    'NO_SHOW': 'badge-error',
    'NEEDS_RESCHEDULE': 'badge-warning'
  } %}
  
  {% set statusLabel = {
    'FREE': 'Libre',
    'BOOKED': 'Reservado',
    'CANCELLED': 'Cancelado',
    'PROPOSED': 'Propuesto',
    'IN_PROGRESS': 'En curso',
    'FULFILLED': 'Cumplido',
    'ARRIVED': 'Llegó',
    'NO_SHOW': 'No asistió',
    'NEEDS_RESCHEDULE': 'A reasignar'
  } %}
  
  {# The grid draws one row per start time, so a cell must stay a single line:
     the patient name rides inside the badge instead of adding a second line
     that would grow that row and break the time scale. #}
  {% set showPatientName = slot.patientName and (userRole == 'ADMIN' or userRole == 'SECRETARY') %}
  {% set statusText = statusLabel[slot.status] or slot.status %}
  <div class="flex items-center slot-trigger cursor-pointer rounded hover:bg-base-200" data-slot-id="{{ slot.id }}" title="{{ (statusText ~ ' · ' ~ slot.patientName) if showPatientName else statusText }}">
    {# Status Badge — el estado normal no lleva color #}
    <span class="badge badge-xs {{ statusBadge[slot.status] or 'badge-neutral' }} w-full justify-center pointer-events-none">
      {% if slot.isOverbook %}
        <i data-lucide="layers" class="w-3 h-3 mr-1" title="Sobreturno"></i>
      {% endif %}
      <span class="min-w-0 truncate">{{ statusText }}{% if showPatientName %} · {{ slot.patientName }}{% endif %}</span>
    </span>
  </div>
{% endmacro %}

{#
  Render Block Info - Shows block reason for privileged users
  
  Parameters:
    - block: BlockInfo object with startDate, endDate, reason
    - userRole: User's role
#}
{% macro renderBlock(block, userRole) %}
  {% if userRole == 'ADMIN' or userRole == 'SECRETARY' %}
    <div class="bg-error/20 text-error text-xs p-2 rounded text-center">
      <div class="flex items-center justify-center gap-1 mb-1">
        <i data-lucide="ban" class="w-4 h-4"></i>
        <span class="font-medium">Día Bloqueado</span>
      </div>
      <p class="text-xs opacity-80">{{ block.reason }}</p>
    </div>
  {% else %}
    <div class="bg-base-300 text-base-content/50 text-xs p-2 rounded text-center">
      <i data-lucide="calendar-x" class="w-4 h-4 mx-auto mb-1"></i>
      No disponible
    </div>
  {% endif %}
{% endmacro %}
