{% extends "layout/base.njk" %}
{% import "partials/form-field.njk" as Field %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Nueva sede", "Registrar una nueva sede.") }}
{% endblock %}

{% block content %}
  <form action="/locations" method="POST" class="max-w-xl space-y-6">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de la sede</legend>

      {{ Field.text({
        name: "name",
        label: "Nombre",
        value: values.name,
        error: errors.properties.name[0] if errors.properties.name else null,
        required: true,
        minlength: 2,
        maxlength: 100,
        placeholder: "Ej: Sede Central"
      }) }}

      {{ Field.text({
        name: "address",
        label: "Dirección",
        value: values.address,
        error: errors.properties.address[0] if errors.properties.address else null,
        required: true,
        minlength: 5,
        maxlength: 255,
        placeholder: "Ej: Av. Principal 123"
      }) }}

      {{ Field.text({
        name: "phone",
        label: "Teléfono",
        value: values.phone,
        error: errors.properties.phone[0] if errors.properties.phone else null,
        maxlength: 20,
        placeholder: "Ej: +54 9 11 1234 5678"
      }) }}
    </fieldset>

    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
      <button type="submit" class="btn btn-primary">Crear sede</button>
      <a href="/locations" class="btn btn-ghost">Cancelar</a>
    </div>
  </form>
{% endblock %}
