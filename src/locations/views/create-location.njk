{% extends "layout/base.njk" %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Nueva Sede", "Registrar una nueva sede.") }}
{% endblock %}

{% block content %}
  <form action="/locations" method="POST" class="w-full max-w-xl mx-auto space-y-8">
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-4">
      <legend>Datos de la sede</legend>

      <div>
        <label class="label">Nombre (requerido)</label>
        <input type="text"
               name="name"
               value="{{ values.name }}"
               class="input validator w-full {{ 'input-error' if errors.properties.name }}"
               required
               minlength="2"
               maxlength="100"
               placeholder="Ej: Sede Central" />
        {% if errors.properties.name %}
          <div class="text-error">{{ errors.properties.name[0] }}</div>
        {% endif %}
      </div>

      <div>
        <label class="label">Dirección (requerido)</label>
        <input type="text"
               name="address"
               value="{{ values.address }}"
               class="input validator w-full {{ 'input-error' if errors.properties.address }}"
               required
               minlength="5"
               maxlength="255"
               placeholder="Ej: Av. Principal 123" />
        {% if errors.properties.address %}
          <div class="text-error">{{ errors.properties.address[0] }}</div>
        {% endif %}
      </div>

      <div>
        <label class="label">Teléfono</label>
        <input type="text"
               name="phone"
               value="{{ values.phone }}"
               class="input validator w-full {{ 'input-error' if errors.properties.phone }}"
               maxlength="20"
               placeholder="Ej: +54 9 11 1234 5678" />
        {% if errors.properties.phone %}
          <div class="text-error">{{ errors.properties.phone[0] }}</div>
        {% endif %}
      </div>

    </fieldset>

    <div class="mt-8 flex flex-col lg:flex-row gap-4">
      <button type="submit" class="btn btn-primary flex-1">
        Crear sede
      </button>
      <a href="/locations" class="btn btn-neutral flex-1">
        Cancelar
      </a>
    </div>
  </form>
{% endblock %}
