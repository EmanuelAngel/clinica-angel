<label for="my-drawer-2" aria-label="close sidebar" class="drawer-overlay"></label>
<div class="flex h-full w-64 flex-col border-r border-base-300 bg-base-200">
  {# Brand #}
  <div class="flex flex-none items-center gap-2 border-b border-base-300 px-4 py-4">
    <span class="grid h-8 w-8 place-items-center rounded-field bg-primary text-primary-content">
      <i data-lucide="hospital" class="h-4 w-4"></i>
    </span>
    <span class="text-sm font-semibold tracking-tight">Clínica Ángel</span>
  </div>

  {# Links Section #}
  <nav class="flex-1 overflow-y-auto">
    <ul class="menu w-full gap-1 p-3 text-sm">
      {% for link in links %}
        {% if link.title %}
          <li>
            <details>
              <summary class="rounded-field">
                <i data-lucide="user-circle"></i>
                {{ link.title }}
              </summary>
              <ul class="p-0">
                {% for link in link.links %}
                  <li>
                    <a href="{{ link.url }}">
                      <i data-lucide="{{ link.icon }}"></i>
                      {{ link.displayName }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </details>
          </li>
        {% else %}
          <li>
            <a href="{{ link.url }}" class="rounded-field">
              <i data-lucide="{{ link.icon }}"></i>
              {{ link.displayName }}
            </a>
          </li>
        {% endif %}
      {% endfor %}

      {# Bandeja de reprogramación: ADMIN y SECRETARY solamente #}
      {% if user and (user.role === Roles.ADMIN or user.role === Roles.SECRETARY) %}
        <li>
          <a href="/schedules/reschedule" class="rounded-field">
            <i data-lucide="refresh-cw"></i>
            Reprogramaciones
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>

  {# Bottom Section: Profile Actions and Theme Controller #}
  <div class="flex-none border-t border-base-300 p-3">
    <ul class="menu w-full flex-col gap-1 text-sm">
      {% if user %}
        {% include "layout/profile-actions.njk" %}
      {% endif %}

      <li>
        {% include "partials/theme-controller-sidebar.njk" %}
      </li>

      {% if user %}
        <li>
          <form action="/auth/logout" method="post" class="w-full">
            <button type="submit" class="btn btn-sm btn-ghost w-full justify-start text-error">
              <i data-lucide="log-out"></i>
              Cerrar sesión
            </button>
          </form>
        </li>
      {% else %}
        <li>
          <a href="/auth/login" class="btn btn-sm btn-primary w-full justify-start">
            <i data-lucide="log-in"></i>
            Iniciar sesión
          </a>
        </li>
      {% endif %}
    </ul>
  </div>
</div>
