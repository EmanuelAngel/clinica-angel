<div class="dropdown dropdown-end">
  <div tabindex="0" role="button" class="btn btn-ghost rounded-field">
    <i data-lucide="user-circle"></i>
    Mi perfil
  </div>
  <ul
    tabindex="-1"
    class="menu dropdown-content bg-base-100 rounded-box z-1 mt-4 w-52 border border-base-300 p-2 shadow-lg">
    <li>
      {% if user.role === Roles.PATIENT %}
        <a href="/patients/{{ user.sub }}">
          <i data-lucide="user"></i>
          Ir a mi perfil
        </a>
      {% elif user.role === Roles.PROFESSIONAL %}
        <a href="/professionals/{{ user.sub }}/profile">
          <i data-lucide="stethoscope"></i>
          Ir a mi perfil
        </a>
      {% else %}
        <a href="/users/{{ user.sub }}">
          <i data-lucide="user"></i>
          Ir a mi perfil
        </a>
      {% endif %}
    </li>
    <li>
      <form action="/auth/logout" method="post">
        <button type="submit" class="text-error">
          <i data-lucide="log-out"></i>
          Cerrar sesión
        </button>
      </form>
    </li>
  </ul>
</div>
