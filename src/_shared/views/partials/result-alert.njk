{% set alertClasses = {
  "failure": "alert-error",
  "success": "alert-success",
  "info": "alert-info",
  "warning": "alert-warning"
} %}

{% set alertIcons = {
  "failure": "alert-circle",
  "success": "check-circle",
  "info": "info-circle",
  "warning": "alert-triangle"
} %}

{% if result %}
<div role="alert" class="alert {{ alertClasses[result.type] }}">
  <i data-lucide="{{ alertIcons[result.type] }}"></i>
  <span>{{ result.message }}</span>
</div>
{% endif %}
