{% macro badge(role) %}
  {# El rol es un dato descriptivo, no un estado: un solo tratamiento visual. #}
  {% if role === Roles.ADMIN %}
    <span class="badge badge-sm badge-ghost">Administrador</span>
  {% endif %}

  {% if role === Roles.SECRETARY %}
    <span class="badge badge-sm badge-ghost">Secretaria</span>
  {% endif %}

  {% if role === Roles.PROFESSIONAL %}
    <span class="badge badge-sm badge-ghost">Profesional</span>
  {% endif %}

  {% if role === Roles.PATIENT %}
    <span class="badge badge-sm badge-ghost">Paciente</span>
  {% endif %}
{% endmacro %}
