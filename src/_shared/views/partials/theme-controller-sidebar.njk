<div class="dropdown dropdown-top dropdown-end w-full">
  <div tabindex="0" role="button" id="theme-dropdown-btn-sidebar" class="btn btn-ghost w-full justify-start">
    <span id="theme-current-icon-sidebar" class="flex items-center">
      <i data-lucide="sun"></i>
    </span>
    <span class="ml-2">Tema</span>
    <i data-lucide="chevron-up" class="h-4 w-4 ml-auto"></i>
  </div>
  <ul tabindex="-1" class="dropdown-content menu bg-base-200 rounded-box z-[1] w-52 p-2 shadow-sm mb-2">
    <li>
      <input
        type="radio"
        name="theme-dropdown-sidebar"
        class="theme-controller btn btn-sm btn-block btn-ghost justify-start"
        aria-label="Claro"
        value="clinic-light" 
      />
      <div class="flex items-center gap-2 pointer-events-none">
        <i data-lucide="sun" class="h-4 w-4"></i>
        <span>Claro</span>
      </div>
    </li>
    <li>
      <input
        type="radio"
        name="theme-dropdown-sidebar"
        class="theme-controller btn btn-sm btn-block btn-ghost justify-start"
        aria-label="Oscuro"
        value="clinic-dark" 
      />
      <div class="flex items-center gap-2 pointer-events-none">
        <i data-lucide="moon" class="h-4 w-4"></i>
        <span>Oscuro</span>
      </div>
    </li>
    <li>
      <input
        type="radio"
        name="theme-dropdown-sidebar"
        class="theme-controller btn btn-sm btn-block btn-ghost justify-start"
        aria-label="Sistema"
        value="system" 
      />
      <div class="flex items-center gap-2 pointer-events-none">
        <i data-lucide="monitor" class="h-4 w-4"></i>
        <span>Sistema</span>
      </div>
    </li>
  </ul>
</div>
