{% extends "layout/base.njk" %}
{% import "partials/form-field.njk" as Field %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Nueva especialidad", "Registrar una nueva especialidad médica.") }}
{% endblock %}

{% block content %}
  <form action="/specialties" method="POST" class="max-w-xl space-y-6">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de la especialidad</legend>

      {{ Field.text({
        name: "name",
        label: "Nombre",
        value: values.name,
        error: errors.properties.name[0] if errors.properties.name else null,
        required: true,
        minlength: 2,
        maxlength: 100,
        placeholder: "Ej: Cardiología",
        hint: "Mínimo 2 caracteres, máximo 100."
      }) }}
    </fieldset>

    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
      <button type="submit" class="btn btn-primary">Crear especialidad</button>
      <a href="/specialties" class="btn btn-ghost">Cancelar</a>
    </div>
  </form>
{% endblock %}
