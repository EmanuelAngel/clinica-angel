{% extends "layout/base.njk" %}
{% import "partials/form-field.njk" as Field %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Registro de usuario", "Registra tu cuenta.") }}
{% endblock %}

{% block content %}
  {% set roleOptions = [
    { value: Roles.SECRETARY, label: "Secretaría" },
    { value: Roles.ADMIN, label: "Administrador" }
  ] %}

  <form action="/users" method="POST" class="max-w-3xl space-y-6">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos personales</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "firstNames",
          label: "Nombres",
          value: values.firstNames,
          error: errors.properties.firstNames[0] if errors.properties.firstNames else null,
          required: true,
          minlength: 2,
          maxlength: 100,
          pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
          title: "Solo letras, espacios, guiones o apóstrofes.",
          placeholder: "Nombre completo",
          hint: "Solo letras, espacios, guiones o apóstrofes. Entre 2 y 100 caracteres."
        }) }}

        {{ Field.text({
          name: "lastNames",
          label: "Apellido",
          value: values.lastNames,
          error: errors.properties.lastNames[0] if errors.properties.lastNames else null,
          required: true,
          minlength: 2,
          maxlength: 100,
          pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
          title: "Solo letras, espacios, guiones o apóstrofes.",
          placeholder: "Apellido",
          hint: "Solo letras, espacios, guiones o apóstrofes. Entre 2 y 100 caracteres."
        }) }}

        {{ Field.text({
          name: "nationalId",
          label: "Número de DNI",
          value: values.nationalId,
          error: errors.properties.nationalId[0] if errors.properties.nationalId else null,
          required: true,
          minlength: 7,
          maxlength: 9,
          pattern: "[0-9]{7,9}",
          title: "El DNI debe tener entre 7 y 9 números sin puntos ni letras.",
          placeholder: "Número de DNI",
          hint: "Entre 7 y 9 números, sin puntos ni letras."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de cuenta</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.select({
          name: "role",
          label: "Rol",
          value: values.role,
          options: roleOptions,
          placeholder: "Seleccione un rol",
          error: errors.properties.role[0] if errors.properties.role else null,
          required: true,
          hint: "Seleccione un rol válido."
        }) }}

        {{ Field.text({
          name: "email",
          type: "email",
          label: "Email",
          value: values.email,
          error: errors.properties.email[0] if errors.properties.email else null,
          required: true,
          placeholder: "correoelectronico@sitio.com",
          hint: "Ingrese un email válido."
        }) }}

        {{ Field.text({
          name: "password",
          type: "password",
          label: "Contraseña",
          error: errors.properties.password[0] if errors.properties.password else null,
          required: true,
          minlength: 8,
          maxlength: 100,
          placeholder: "Contraseña",
          hint: "Entre 8 y 100 caracteres."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de contacto</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "phone",
          type: "tel",
          label: "Teléfono",
          value: values.phone,
          error: errors.properties.phone[0] if errors.properties.phone else null,
          required: true,
          placeholder: "Número de teléfono",
          hint: "Ingrese un número de teléfono válido."
        }) }}

        {{ Field.text({
          name: "address",
          label: "Dirección",
          value: values.address,
          error: errors.properties.address[0] if errors.properties.address else null,
          required: true,
          minlength: 5,
          maxlength: 180,
          placeholder: "Dirección",
          hint: "Ingrese una dirección válida."
        }) }}
      </div>
    </fieldset>

    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
      <button type="reset" class="btn btn-ghost">Limpiar formulario</button>
      <button type="submit" class="btn btn-primary">Registrar</button>
    </div>
  </form>
{% endblock %}
