{% extends "layout/base.njk" %}
{% import "partials/form-field.njk" as Field %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Editar perfil", "Editando el perfil de " + user.fullName + ".") }}
{% endblock %}

{% block content %}
  <div class="max-w-3xl space-y-6">

    {# Identidad y rol #}
    <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0">
          <h2 class="text-sm font-semibold tracking-tight">{{ user.fullName }}</h2>
          <p class="text-sm text-base-content/70 break-all">
            {{ user.email }} · DNI {{ user.nationalId }}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {% import "partials/role-badge.njk" as RoleBadge %}
          {{ RoleBadge.badge(user.role) }}
          {% import "partials/user-status-badge.njk" as UserStatus %}
          {{ UserStatus.badge(user.isActive) }}
        </div>
      </div>
    </section>

    <form action="/users/{{ user.id }}" method="POST" class="space-y-6">
      <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
        <legend class="text-sm font-semibold">Datos personales</legend>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {{ Field.text({
            name: "firstNames",
            label: "Nombres",
            value: values.firstNames if values else user.firstNames,
            error: errors.properties.firstNames[0] if errors.properties.firstNames else null,
            required: true,
            minlength: 2,
            maxlength: 100,
            pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
            title: "Solo letras, espacios, guiones o apóstrofes.",
            placeholder: "Nombre completo",
            hint: "Solo letras, espacios, guiones o apóstrofes. Mínimo 2 caracteres."
          }) }}

          {{ Field.text({
            name: "lastNames",
            label: "Apellidos",
            value: values.lastNames if values else user.lastNames,
            error: errors.properties.lastNames[0] if errors.properties.lastNames else null,
            required: true,
            minlength: 2,
            maxlength: 100,
            pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
            title: "Solo letras, espacios, guiones o apóstrofes.",
            placeholder: "Apellido",
            hint: "Solo letras, espacios, guiones o apóstrofes. Mínimo 2 caracteres."
          }) }}
        </div>
      </fieldset>

      <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
        <legend class="text-sm font-semibold">Datos de contacto</legend>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {{ Field.text({
            name: "phone",
            type: "tel",
            label: "Teléfono",
            value: values.phone if values else user.phone,
            error: errors.properties.phone[0] if errors.properties.phone else null,
            required: true,
            placeholder: "Número de teléfono",
            hint: "Ingrese un número de teléfono válido."
          }) }}

          {{ Field.text({
            name: "address",
            label: "Dirección",
            value: values.address if values else user.address,
            error: errors.properties.address[0] if errors.properties.address else null,
            required: true,
            minlength: 5,
            maxlength: 180,
            placeholder: "Dirección",
            hint: "Ingrese una dirección válida."
          }) }}
        </div>
      </fieldset>

      <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
        <button type="submit" class="btn btn-primary">
          <i data-lucide="save" class="h-4 w-4"></i>
          Guardar cambios
        </button>
        <a href="/users/{{ user.id }}" class="btn btn-ghost">Cancelar</a>
      </div>
    </form>

  </div>
{% endblock %}
