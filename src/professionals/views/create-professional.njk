{% extends "layout/base.njk" %}
{% import "partials/form-field.njk" as Field %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Registrar profesional", "Registrar un nuevo profesional de la salud.") }}
{% endblock %}

{% block content %}
  <form action="/professionals" method="POST" class="max-w-3xl space-y-6">
    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos personales</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "firstNames",
          label: "Nombres",
          value: values.firstNames,
          error: errors.properties.firstNames[0] if errors.properties.firstNames else null,
          required: true,
          minlength: 2,
          maxlength: 100,
          pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
          title: "Solo letras, espacios, guiones o apóstrofes.",
          placeholder: "Nombre completo",
          hint: "Solo letras, espacios, guiones o apóstrofes. Mínimo 2 caracteres."
        }) }}

        {{ Field.text({
          name: "lastNames",
          label: "Apellido",
          value: values.lastNames,
          error: errors.properties.lastNames[0] if errors.properties.lastNames else null,
          required: true,
          minlength: 2,
          maxlength: 100,
          pattern: "[a-zA-ZÀ-ÿñÑ\\s'-]+",
          title: "Solo letras, espacios, guiones o apóstrofes.",
          placeholder: "Apellido",
          hint: "Solo letras, espacios, guiones o apóstrofes. Mínimo 2 caracteres."
        }) }}

        {{ Field.text({
          name: "nationalId",
          label: "Número de DNI",
          value: values.nationalId,
          error: errors.properties.nationalId[0] if errors.properties.nationalId else null,
          required: true,
          minlength: 7,
          maxlength: 9,
          pattern: "[0-9]{7,9}",
          title: "El DNI debe tener entre 7 y 9 números sin puntos ni letras.",
          placeholder: "Número de DNI",
          hint: "Entre 7 y 9 números, sin puntos ni letras."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de cuenta</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "email",
          type: "email",
          label: "Email",
          value: values.email,
          error: errors.properties.email[0] if errors.properties.email else null,
          required: true,
          placeholder: "correoelectronico@sitio.com",
          hint: "Ingrese un email válido."
        }) }}

        {{ Field.text({
          name: "password",
          type: "password",
          label: "Contraseña",
          error: errors.properties.password[0] if errors.properties.password else null,
          required: true,
          minlength: 8,
          maxlength: 100,
          placeholder: "Contraseña",
          hint: "Entre 8 y 100 caracteres."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Datos de contacto</legend>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        {{ Field.text({
          name: "phone",
          type: "tel",
          label: "Teléfono",
          value: values.phone,
          error: errors.properties.phone[0] if errors.properties.phone else null,
          required: true,
          placeholder: "Número de teléfono",
          hint: "Ingrese un número de teléfono válido."
        }) }}

        {{ Field.text({
          name: "address",
          label: "Dirección",
          value: values.address,
          error: errors.properties.address[0] if errors.properties.address else null,
          required: true,
          minlength: 5,
          maxlength: 180,
          placeholder: "Dirección",
          hint: "Ingrese una dirección válida."
        }) }}
      </div>
    </fieldset>

    <fieldset class="fieldset rounded-box border border-base-300 bg-base-100 p-4">
      <legend class="text-sm font-semibold">Especialidades y matrículas (opcional)</legend>
      <p class="text-sm text-base-content/70">
        Podés agregar cero o más especialidades con su número de matrícula.
      </p>

      <div id="credentials-container" class="mt-3 space-y-3"></div>

      <div class="mt-3">
        <button type="button" id="add-credential-btn" class="btn btn-sm btn-outline">
          <i data-lucide="plus" class="h-4 w-4"></i>
          Agregar especialidad
        </button>
      </div>

      {% if errors.properties.credentials %}
        <p class="mt-2 text-xs text-error">Error en las especialidades. Verificá los datos.</p>
      {% endif %}
    </fieldset>

    <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
      <a href="/professionals" class="btn btn-ghost">Cancelar</a>
      <button type="submit" class="btn btn-primary">Registrar profesional</button>
    </div>
  </form>
{% endblock %}

{% block scripts %}
  <script type="module">
    const container = document.getElementById('credentials-container');
    const addBtn = document.getElementById('add-credential-btn');
    let credentialIndex = 0;

    const specialties = {{ specialties | json }};

    /**
     * Las filas de especialidades se generan en el cliente, así que no pasan por
     * el macro de campos: replican a mano el mismo contrato (etiqueta con for,
     * id en el control y el par validator/validator-hint).
     * @param {number} index
     * @returns {HTMLDivElement}
     */
    function createCredentialRow(index) {
      const row = document.createElement('div');
      row.className = 'grid items-end gap-3 sm:grid-cols-[1fr_1fr_auto]';
      row.setAttribute('data-credential-row', '');
      row.innerHTML = `
        <div>
          <label for="cred-${index}-specialty" class="text-xs font-medium text-base-content/70">Especialidad</label>
          <select
            id="cred-${index}-specialty"
            name="credentials[${index}][specialtyId]"
            class="select validator mt-1 w-full"
            required
          >
            <option value="" disabled selected>Seleccione una especialidad</option>
            ${specialties.map((s) => `<option value="${s.id}">${s.name}</option>`).join('')}
          </select>
        </div>
        <div>
          <label for="cred-${index}-license" class="text-xs font-medium text-base-content/70">Número de matrícula</label>
          <input
            type="text"
            id="cred-${index}-license"
            name="credentials[${index}][licenseNumber]"
            class="input validator mt-1 w-full"
            placeholder="Ej: MP-12345"
            required
          />
        </div>
        <div>
          <button
            type="button"
            class="btn btn-sm btn-ghost text-error"
            aria-label="Quitar especialidad"
            onclick="this.closest('[data-credential-row]').remove()"
          >
            <i data-lucide="trash-2" class="h-4 w-4"></i>
          </button>
        </div>
      `;
      return row;
    }

    addBtn.addEventListener('click', () => {
      container.appendChild(createCredentialRow(credentialIndex++));
      lucide.createIcons();
    });
  </script>
{% endblock %}
