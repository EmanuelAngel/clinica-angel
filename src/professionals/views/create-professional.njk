{% extends "layout/base.njk" %}

{% block head %}
  <style>
    .credential-row {
      display: flex;
      gap: 1rem;
      align-items: end;
      margin-bottom: 0.5rem;
    }
    .credential-row > div {
      flex: 1;
    }
    .credential-row .remove-btn {
      flex: 0 0 auto;
    }
  </style>
{% endblock %}

{% block pageInfo %}
  {% import "partials/page-info.njk" as PageInfo %}
  {{ PageInfo.titleAndDescription("Registrar Profesional", "Registrar un nuevo profesional de la salud.") }}
{% endblock %}

{% block content %}
  <form action="/professionals" method="POST" class="w-full max-w-3xl mx-auto space-y-12">
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-4">
      <legend>Datos personales</legend>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div>
          <label class="label">Nombres (requerido)</label>
          <input type="text"
                 name="firstNames"
                 value="{{ values.firstNames }}"
                 class="input validator w-full {{ 'input-error' if errors.properties.firstNames }}"
                 required
                 minlength="2"
                 maxlength="100"
                 pattern="[a-zA-ZÀ-ÿ\u00f1\u00d1\s'-]+"
                 title="Solo letras, espacios, guiones o apóstrofes."
                 placeholder="Nombre completo" />
          {% if errors.properties.firstNames %}
            <div class="text-error">{{ errors.properties.firstNames[0] }}</div>
          {% endif %}
          <div class="validator-hint">
            Solo letras, espacios, guiones o apóstrofes. Mínimo 2 caracteres.
          </div>
        </div>

        <div>
          <label class="label">Apellido (requerido)</label>
          <input type="text"
                 name="lastNames"
                 value="{{ values.lastNames }}"
                 class="input validator w-full {{ 'input-error' if errors.properties.lastNames }}"
                 required
                 minlength="2"
                 maxlength="100"
                 pattern="[a-zA-ZÀ-ÿ\u00f1\u00d1\s'-]+"
                 title="Solo letras, espacios, guiones o apóstrofes."
                 placeholder="Apellido" />
          {% if errors.properties.lastNames %}
            <div class="text-error">{{ errors.properties.lastNames[0] }}</div>
          {% endif %}
          <div class="validator-hint">
            Solo letras, espacios, guiones o apóstrofes. Mínimo 2 caracteres.
          </div>
        </div>

        <div>
          <label class="label">Número de DNI (requerido)</label>
          <input type="text"
                 name="nationalId"
                 value="{{ values.nationalId }}"
                 class="input validator w-full {{ 'input-error' if errors.properties.nationalId }}"
                 required
                 minlength="7"
                 maxlength="9"
                 pattern="[0-9]{7,9}"
                 title="El DNI debe tener entre 7 y 9 números sin puntos ni letras."
                 placeholder="Número de DNI" />
          {% if errors.properties.nationalId %}
            <div class="text-error">{{ errors.properties.nationalId[0] }}</div>
          {% endif %}
          <div class="validator-hint">
            El DNI debe tener entre 7 y 9 números sin puntos ni letras.
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-4">
      <legend>Datos de cuenta</legend>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div>
          <label class="label">Email (requerido)</label>
          <input type="email"
                 name="email"
                 value="{{ values.email }}"
                 class="input validator w-full {{ 'input-error' if errors.properties.email }}"
                 required
                 placeholder="correoelectronico@sitio.com" />
          {% if errors.properties.email %}
            <div class="text-error">{{ errors.properties.email[0] }}</div>
          {% endif %}
          <div class="validator-hint">Ingrese un email válido</div>
        </div>

        <div>
          <label class="label">Contraseña (requerido)</label>
          <input type="password"
                 name="password"
                 class="input validator w-full {{ 'input-error' if errors.properties.password }}"
                 required
                 minlength="8"
                 maxlength="100"
                 placeholder="Contraseña" />
          {% if errors.properties.password %}
            <div class="text-error">{{ errors.properties.password[0] }}</div>
          {% endif %}
          <div class="validator-hint">
            Mínimo 8 caracteres. Máximo 100 caracteres.
          </div>
        </div>
      </div>
    </fieldset>

    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-4">
      <legend>Datos de contacto</legend>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div>
          <label class="label">Teléfono (requerido)</label>
          <input type="tel"
                 name="phone"
                 value="{{ values.phone }}"
                 class="input validator w-full {{ 'input-error' if errors.properties.phone }}"
                 required
                 placeholder="Número de teléfono" />
          {% if errors.properties.phone %}
            <div class="text-error">{{ errors.properties.phone[0] }}</div>
          {% endif %}
          <div class="validator-hint">Ingrese un número de teléfono válido</div>
        </div>

        <div>
          <label class="label">Dirección (requerido)</label>
          <input type="text"
                 name="address"
                 value="{{ values.address }}"
                 class="input validator w-full {{ 'input-error' if errors.properties.address }}"
                 required
                 minlength="5"
                 maxlength="180"
                 placeholder="Dirección" />
          {% if errors.properties.address %}
            <div class="text-error">{{ errors.properties.address[0] }}</div>
          {% endif %}
          <div class="validator-hint">Ingrese una dirección válida</div>
        </div>
      </div>
    </fieldset>

    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-4">
      <legend>Especialidades y Matrículas (opcional)</legend>
      <p class="text-sm text-base-content/70 mb-4">
        Puede agregar cero o más especialidades con sus respectivos números de matrícula.
      </p>

      <div id="credentials-container"></div>

      <button type="button" id="add-credential-btn" class="btn btn-outline btn-sm mt-2">
        <i data-lucide="plus"></i>
        Agregar especialidad
      </button>

      {% if errors.properties.credentials %}
        <div class="text-error mt-2">Error en las especialidades. Verifique los datos.</div>
      {% endif %}
    </fieldset>

    <div class="mt-8 flex flex-col lg:flex-row gap-4">
      <button type="submit" class="btn btn-primary flex-1">
        Registrar profesional
      </button>
      <a href="/professionals" class="btn btn-neutral flex-1">
        Cancelar
      </a>
    </div>
  </form>
{% endblock %}

{% block scripts %}
  <script type="module">
    const container = document.getElementById('credentials-container');
    const addBtn = document.getElementById('add-credential-btn');
    let credentialIndex = 0;

    const specialties = {{ specialties | dump | safe }};

    function createCredentialRow(index) {
      const row = document.createElement('div');
      row.className = 'credential-row';
      row.innerHTML = `
        <div>
          <label class="label label-text">Especialidad</label>
          <select name="credentials[${index}][specialtyId]" class="select select-bordered w-full" required>
            <option value="" disabled selected>Seleccione...</option>
            ${specialties.map(s => `<option value="${s.id}">${s.name}</option>`).join('')}
          </select>
        </div>
        <div>
          <label class="label label-text">Número de matrícula</label>
          <input type="text" name="credentials[${index}][licenseNumber]" class="input input-bordered w-full" placeholder="Ej: MP-12345" required />
        </div>
        <div class="remove-btn">
          <button type="button" class="btn btn-error btn-sm" onclick="this.closest('.credential-row').remove()">
            <i data-lucide="trash-2"></i>
          </button>
        </div>
      `;
      return row;
    }

    addBtn.addEventListener('click', () => {
      container.appendChild(createCredentialRow(credentialIndex++));
      lucide.createIcons();
    });
  </script>
{% endblock %}
