{% extends "layout/base.njk" %}

{% block content %}
  <div class="space-y-6">

    {# Identidad: es el encabezado de la página, no una card que repite el título #}
    <section class="rounded-box border border-base-300 bg-base-100 p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex min-w-0 items-center gap-4">
          <div class="avatar placeholder">
            <div class="w-12 rounded-full bg-primary text-primary-content">
              <span class="text-lg">{{ professional.firstNames[0] }}{{ professional.lastNames[0] }}</span>
            </div>
          </div>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h1 class="text-lg font-semibold tracking-tight">{{ professional.fullName }}</h1>
              {% if professional.isActive %}
                <span class="badge badge-sm badge-success">Activo</span>
              {% else %}
                <span class="badge badge-sm badge-ghost">Inactivo</span>
              {% endif %}
            </div>
            <p class="text-sm text-base-content/70">Profesional #{{ professional.id }}</p>
          </div>
        </div>
        {% if isAdmin %}
          <a href="/users/{{ professional.id }}/edit" class="btn btn-sm btn-primary">
            <i data-lucide="pencil" class="h-4 w-4"></i>
            Editar perfil
          </a>
        {% endif %}
      </div>
    </section>

    {# Resultado de agregar especialidad #}
    {% if result %}
      <div role="alert" class="alert {{ 'alert-success' if result.type === 'success' else 'alert-error' }}">
        <i data-lucide="{{ 'check-circle' if result.type === 'success' else 'alert-circle' }}" class="h-4 w-4"></i>
        <span class="text-sm">{{ result.message }}</span>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

      {# Columna de datos #}
      <div class="space-y-6 lg:col-span-1">

        <section class="rounded-box border border-base-300 bg-base-100 p-4">
          <h2 class="text-xs font-medium text-base-content/70">Datos personales</h2>
          <dl class="mt-3 space-y-2 text-sm">
            <div>
              <dt class="text-base-content/70">Email</dt>
              <dd class="font-medium break-all">{{ professional.email }}</dd>
            </div>
            <div>
              <dt class="text-base-content/70">DNI</dt>
              <dd class="font-medium tabular-nums">{{ professional.nationalId }}</dd>
            </div>
            <div>
              <dt class="text-base-content/70">Teléfono</dt>
              <dd class="font-medium tabular-nums">{{ professional.phone }}</dd>
            </div>
            <div>
              <dt class="text-base-content/70">Dirección</dt>
              <dd class="font-medium">{{ professional.address }}</dd>
            </div>
          </dl>
        </section>

        <section class="rounded-box border border-base-300 bg-base-100 p-4">
          <h2 class="text-xs font-medium text-base-content/70">Especialidades y matrículas</h2>

          {% if specialties.length > 0 %}
            <dl class="mt-3 space-y-2 text-sm">
              {% for cred in specialties %}
                <div class="flex items-baseline justify-between gap-3">
                  <dt class="font-medium">{{ cred.specialtyName }}</dt>
                  <dd class="font-mono text-[13px] tabular-nums text-base-content/70">{{ cred.licenseNumber }}</dd>
                </div>
              {% endfor %}
            </dl>
          {% else %}
            <p class="mt-3 text-sm text-base-content/70">No tiene especialidades registradas.</p>
          {% endif %}

          {% if isAdmin %}
            <form action="/professionals/{{ professional.id }}/specialties" method="POST" class="mt-4 space-y-3 border-t border-base-300 pt-4">
              <p class="text-xs font-medium text-base-content/70">Agregar especialidad</p>

              <div>
                <label for="specialtyId" class="text-xs font-medium text-base-content/70">Especialidad</label>
                <select
                  id="specialtyId"
                  name="specialtyId"
                  class="select select-sm mt-1 w-full {{ 'select-error' if errors and errors.properties.specialtyId }}"
                  required
                >
                  <option value="" disabled selected>Seleccionar especialidad</option>
                  {% for spec in allSpecialties %}
                    <option value="{{ spec.id }}">{{ spec.name }}</option>
                  {% endfor %}
                </select>
                {% if errors and errors.properties.specialtyId %}
                  <p class="mt-1 text-xs text-error">{{ errors.properties.specialtyId[0] }}</p>
                {% endif %}
              </div>

              <div>
                <label for="licenseNumber" class="text-xs font-medium text-base-content/70">Número de matrícula</label>
                <input
                  type="text"
                  id="licenseNumber"
                  name="licenseNumber"
                  class="input input-sm mt-1 w-full {{ 'input-error' if errors and errors.properties.licenseNumber }}"
                  placeholder="MP-12345"
                  required
                  minlength="1"
                  maxlength="50"
                />
                {% if errors and errors.properties.licenseNumber %}
                  <p class="mt-1 text-xs text-error">{{ errors.properties.licenseNumber[0] }}</p>
                {% endif %}
              </div>

              <button type="submit" class="btn btn-sm btn-primary w-full">
                <i data-lucide="plus" class="h-4 w-4"></i>
                Agregar
              </button>
            </form>
          {% endif %}
        </section>

      </div>

      {# Columna de agenda #}
      <div class="lg:col-span-2">
        <section class="overflow-hidden rounded-box border border-base-300 bg-base-100">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-base-300 p-4">
            <h2 class="text-sm font-semibold">Agenda de turnos</h2>
            {% if schedules and schedules.length > 0 %}
              <div class="flex flex-wrap gap-1">
                {% for sched in schedules %}
                  <a href="/schedules/{{ sched.id }}/agenda" class="btn btn-xs btn-ghost">
                    <i data-lucide="calendar-days" class="h-3 w-3"></i>
                    {{ sched.specialtyName }} — {{ sched.classificationName }}
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class="tabs tabs-border px-4 pt-2">
            {% macro renderSlotList(slots, emptyMessage) %}
              {% if slots.length > 0 %}
                <ul class="divide-y divide-base-300">
                  {% for slot in slots %}
                    <li class="flex flex-wrap items-start justify-between gap-3 p-4">
                      <div class="flex min-w-0 items-start gap-3">
                        <div class="min-w-14 rounded-field bg-base-200 px-2 py-1 text-center">
                          <div class="text-xs text-base-content/70 tabular-nums">{{ slot.startsAt | date("DD/MM") }}</div>
                          <div class="font-mono text-sm font-medium tabular-nums">{{ slot.startsAt | time }}</div>
                        </div>
                        <div class="min-w-0">
                          <p class="text-sm font-medium">{{ slot.patientName }}</p>
                          <p class="text-xs text-base-content/60 tabular-nums">DNI {{ slot.patientNationalId }}</p>
                          <p class="mt-1 text-xs text-base-content/70">
                            {{ slot.specialty }} · {{ slot.classification }}
                            {% if slot.insuranceName %}
                              · {{ slot.insuranceName }}
                              <span class="font-mono">{{ slot.insuranceMemberNumber }}</span>
                            {% else %}
                              · Particular
                            {% endif %}
                          </p>
                          {% if slot.consultationReason %}
                            <p class="mt-1 line-clamp-2 text-xs text-base-content/60">{{ slot.consultationReason }}</p>
                          {% endif %}
                        </div>
                      </div>
                      <div>
                        {% import "macros/slot-status-badge.njk" as StatusBadge %}
                        {{ StatusBadge.renderStatusBadge(slot.status, slot.isOverbook) }}
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <div class="px-6 py-12 text-center">
                  <p class="text-sm text-base-content/70">{{ emptyMessage }}</p>
                </div>
              {% endif %}
            {% endmacro %}

            {# Tab 1: Hoy #}
            <input type="radio" name="agenda_tabs" role="tab" class="tab" aria-label="Hoy" checked="checked" />
            <div role="tabpanel" class="tab-content p-0 pt-2">
              {{ renderSlotList(slotsToday, "No hay turnos programados para hoy.") }}
            </div>

            {# Tab 2: Futuros #}
            <input type="radio" name="agenda_tabs" role="tab" class="tab" aria-label="Futuros" />
            <div role="tabpanel" class="tab-content p-0 pt-2">
              {{ renderSlotList(slotsFuture, "No hay turnos futuros pendientes.") }}
            </div>

            {# Tab 3: Pasados #}
            <input type="radio" name="agenda_tabs" role="tab" class="tab" aria-label="Pasados" />
            <div role="tabpanel" class="tab-content p-0 pt-2">
              {{ renderSlotList(slotsPast, "No hay historial de turnos pasados.") }}
            </div>
          </div>
        </section>
      </div>

    </div>

    <div>
      <a href="/professionals" class="btn btn-sm btn-ghost">
        <i data-lucide="arrow-left" class="h-4 w-4"></i>
        Volver a la lista
      </a>
    </div>

  </div>
{% endblock %}
