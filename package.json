{
  "name": "clinica-angel",
  "version": "0.0.0",
  "description": "Clinic appointment scheduler for University",
  "homepage": "https://github.com/EmanuelAngel/clinica-angel#readme",
  "bugs": {
    "url": "https://github.com/EmanuelAngel/clinica-angel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmanuelAngel/clinica-angel.git"
  },
  "license": "ISC",
  "author": "Angel Emanuel",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "css:build": "pnpx @tailwindcss/cli -i ./src/_assets/css/main.css -o ./src/_assets/css/output.css --minify",
    "css:watch": "pnpx @tailwindcss/cli -i ./src/_assets/css/main.css -o ./src/_assets/css/output.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:debug": "set LOG_ERRORS=true&& pnpm run test",
    "test:watch": "pnpm run test -- --watch",
    "test:cov": "pnpm run test -- --coverage",
    "prepare": "husky",
    "db:seed": "node prisma/seed.js",
    "db:clean": "dotenv node scripts/clean-db.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.2.0",
    "@prisma/client": "7.2.0",
    "@prisma/client-runtime-utils": "7.2.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "4.22.1",
    "express-async-errors": "3.1.1",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.10.1",
    "ms": "2.1.3",
    "multer": "2.0.2",
    "neverthrow": "8.2.0",
    "nunjucks": "3.2.4",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-conventional": "20.2.0",
    "@eslint/css": "0.14.1",
    "@eslint/js": "9.39.2",
    "@eslint/json": "0.14.0",
    "@tailwindcss/cli": "4.1.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.3",
    "daisyui": "5.5.14",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.5.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "nodemon": "3.1.11",
    "prettier": "3.7.4",
    "prisma": "7.2.0",
    "supertest": "7.1.4",
    "tailwindcss": "4.1.18"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
