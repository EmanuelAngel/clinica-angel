{
  "name": "clinica-angel",
  "version": "0.0.0",
  "description": "Clinic appointment scheduler for University",
  "homepage": "https://github.com/EmanuelAngel/clinica-angel#readme",
  "bugs": {
    "url": "https://github.com/EmanuelAngel/clinica-angel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmanuelAngel/clinica-angel.git"
  },
  "license": "ISC",
  "author": "Angel Emanuel",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm run test -- --watch",
    "test:cov": "npm run test -- --coverage"
  },
  "dependencies": {
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@eslint/css": "0.14.1",
    "@eslint/js": "9.39.2",
    "@eslint/json": "0.14.0",
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.5.0",
    "eslint-plugin-jsdoc": "61.5.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.5.0",
    "prettier": "3.7.4"
  }
}
